{
  "manifest_version": 3,
  "name": "Ads Launcher",
  "version": "1.0",
  "description": "One-click links to every ad account's Ads Manager.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ads Launcher",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A", "mac": "MacCtrl+Shift+A" },
      "description": "Open Ads Launcher"
    }
  }
}
